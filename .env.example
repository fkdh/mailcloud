PORT=3000

# PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:password@localhost:5432/mailcloud

# Base64 encoded 32-byte key used to encrypt Gmail App Passwords in the database.
# Generate with: openssl rand -base64 32
SENDER_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64-key

# Google OAuth web application credentials. Add the callback URL to Google Cloud:
# http://localhost:3000/api/gmail/oauth/callback
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/oauth/callback

# Seed superadmin credentials.
SUPERADMIN_NAME=System Administrator
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-this-password
